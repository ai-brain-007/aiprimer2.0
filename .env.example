# Names of the settings the pipeline reads. Put the VALUES on the Claude Code cloud
# environment ("Environment variables" box), never in this repository, in a sheet, or in a chat.

# ---- Google, service-account mode (primary) -------------------------------------------------
# The whole key JSON on one line (or its base64). One key serves every account row.
# The service account must be a Content manager of the Shared Drives below: it owns no storage
# of its own, so it cannot upload into a personal Gmail Drive.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Google Workspace Shared Drive ids (from the drive's URL: drive.google.com/drive/folders/<id>)
AIPRIMER_RAW_DRIVE_ID=
AIPRIMER_SUMMARY_DRIVE_ID=

# ---- Google, refresh-token mode (fallback for plain Gmail accounts) -------------------------
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN_RAW01=
# GOOGLE_REFRESH_TOKEN_SUMMARY01=

# ID of the Google Sheet "AI Primer Control Panel" (from its URL). Not secret.
AIPRIMER_CONTROL_SHEET_ID=

# Apify: prefer the environment's "API credentials" box (host api.apify.com, header Authorization,
# prefix Bearer). Only set this variable as a fallback on plans without API credentials.
# APIFY_TOKEN=

# Optional overrides
# AIPRIMER_CONFIG=config/pipeline.yaml
# AIPRIMER_CACHE_DIR=.cache
# AIPRIMER_WORK_DIR=.work
# GOOGLE_SA_IMPERSONATE=user@yourdomain.com   (domain-wide delegation, Workspace only)

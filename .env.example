# Names of the settings the pipeline reads. Put the VALUES on the Claude Code cloud environment
# ("Environment variables" box, or the "API credentials" box for host-scoped tokens), never in this
# repository, in a page, in a database or in a chat.

# ---- v2 (current): Backblaze B2 for files, Notion for the control panel and the pages ----------

# Backblaze: one account per number. The application key must be allowed on both buckets of that account.
B2_KEY_ID_0001=
B2_APPLICATION_KEY_0001=
# Bucket names are global across Backblaze. Defaults: ai-primer-raw-0001 (Private) and ai-primer-media-0001
# (Public). Set these only if you had to choose other names.
# B2_BUCKET_0001=
# B2_MEDIA_BUCKET_0001=
# A second account when the first is full: B2_KEY_ID_0002 / B2_APPLICATION_KEY_0002 (+ its buckets); run /setup.

# Notion: the id of the "AI Primer" page (32 characters at the end of its address). Setting it turns Notion
# mode on. The integration secret goes in the API credentials box (host api.notion.com, header Authorization,
# prefix Bearer); use NOTION_TOKEN only on a plan without API credentials.
AIPRIMER_NOTION_PAGE_ID=
# NOTION_TOKEN=

# Apify: API credentials box (host api.apify.com, header Authorization, prefix Bearer). Fallback only:
# APIFY_TOKEN=

# ---- v1 (legacy, Google Drive / Sheets / Docs) ------------------------------------------------
# GOOGLE_SERVICE_ACCOUNT_JSON_RAW=
# GOOGLE_SERVICE_ACCOUNT_JSON_SUMMARY=
# AIPRIMER_RAW_DRIVE_ID=
# AIPRIMER_SUMMARY_DRIVE_ID=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN_RAW01=
# GOOGLE_REFRESH_TOKEN_SUMMARY01=
# AIPRIMER_CONTROL_SHEET_ID=

# Optional overrides
# AIPRIMER_CONFIG=config/pipeline.yaml
# AIPRIMER_CACHE_DIR=.cache
# AIPRIMER_WORK_DIR=.work
